{
  "name": "@kunalpanchal/formsync-web",
  "version": "1.0.1",
  "description": "Vanilla form-sync-button (default UI, CSS parts, unstyled/headless) and data-formsync auto-init.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kunalpanchal/autofill-mcp.git",
    "directory": "packages/web"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kunalpanchal/formsync-core": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "^17.6.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
